---
/**
 * A quiet miniature of the motor trace, used as a mark under the name.
 *
 * Job: spatial continuity. It ties the personal page to the research page
 * without building a second showpiece that competes with the real trace.
 *
 * Deliberately NOT stretched to the full column width. A short viewBox scaled
 * across a wide container flattens the curves into disconnected segments and
 * reads as a rendering bug, so this keeps its natural aspect and stays small.
 */

const BASE = 22;
const strokes = [
  { x: 4, w: 30, apexY: 5 },
  { x: 40, w: 24, apexY: 11 },
  { x: 70, w: 26, apexY: 8 },
];

let d = `M 0 ${BASE}`;
for (const { x, w, apexY } of strokes) {
  d += ` L ${x} ${BASE}`;
  d += ` C ${x + w * 0.12} ${BASE}, ${x + w * 0.2} ${apexY}, ${x + w * 0.34} ${apexY}`;
  d += ` C ${x + w * 0.5} ${apexY}, ${x + w * 0.62} ${BASE - 2}, ${x + w} ${BASE}`;
}
d += ` L 104 ${BASE}`;
---

<div class="trace-rule" aria-hidden="true">
  <svg viewBox="0 0 104 26">
    <path d={d} pathLength="100" fill="none" />
  </svg>
</div>

<style>
  .trace-rule {
    margin: var(--space-lg) 0 var(--space-xl);
  }

  .trace-rule svg {
    display: block;
    width: 168px;
    height: auto;
    overflow: visible;
  }

  path {
    stroke: var(--trace);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: draw-rule 1600ms var(--ease-out) 400ms forwards;
  }

  @keyframes draw-rule {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
