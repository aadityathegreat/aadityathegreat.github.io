---
import Base from "../layouts/Base.astro";
import MotorTrace from "../components/MotorTrace.astro";
import Contact from "../components/Contact.astro";

const title = "Research — Aaditya Ananth";
const description =
  "A stroke-aide device for pianists, a nine month study of neurology access in Texas, and clinical time in a Neuro ICU.";

// Everything here traces to library/resume/master.md or outreach-base.md.
// Nothing gets added to this list that is not on one of those two.
const experience = [
  {
    id: "neurology-access",
    org: "AP Research and Career Independent Study",
    place: "with Cook Children's Medical",
    when: "Aug 2024 to May 2026",
    status: "nine months",
    body: [
      "A study of how regional politics in Texas affect women's access to neurology care. I pulled statewide neurologist supply, insurance rates and stroke outcome data into one cross-sectional design and ran regressions on it.",
      "I also built an adaptive learning system for neuroscience education, working with neurosurgeon Dr. Daniel Hansen to keep it close to how clinical training actually works.",
    ],
  },
  {
    id: "youth-path",
    org: "Youth Path Foundation",
    place: "Frisco, TX",
    when: "Aug 2025 to May 2026",
    status: "research intern",
    body: [
      "PCR and gel electrophoresis on more than 30 DNA samples, supporting neurology and cytogenetics work.",
    ],
  },
  {
    id: "neuro-icu",
    org: "Medical City Plano, Neuro ICU",
    place: "Plano, TX",
    when: "Jun to Aug 2024",
    status: "volunteer to intern",
    body: [
      "Checked more than 500 patient charts for accuracy across teams and cut redundant steps out of the documentation workflow, which brought patient update times down.",
      "Bedside support during stroke and end of life cases. This is where the rehabilitation questions stopped being academic for me.",
    ],
  },
];

// The index at the top of the page. It exists because this is the page a PI opens
// from a cold email, usually on a phone, and the first screen was previously
// spending its whole height on a heading and a question. Four dated lines put the
// actual evidence in front of a twenty second skim, and they double as in-page
// navigation on mobile where the page is long. Every line is drawn from the
// entries below, so it can never drift into a claim the page does not support.
const index = [
  {
    href: "#device",
    when: "Jun to Jul 2025",
    what: "A stroke-aide device for pianists",
    gloss: "a force sensor under every key, tested with 30+ participants at UT Austin",
  },
  {
    href: "#neurology-access",
    when: "Aug 2024 to May 2026",
    what: "Neurology access across Texas",
    gloss: "a nine month cross-sectional study, with Cook Children's Medical",
  },
  {
    href: "#youth-path",
    when: "Aug 2025 to May 2026",
    what: "Youth Path Foundation",
    gloss: "PCR and gel electrophoresis on more than 30 DNA samples",
  },
  {
    href: "#neuro-icu",
    when: "Jun to Aug 2024",
    what: "Neuro ICU, Medical City Plano",
    gloss: "500+ charts, and bedside time during stroke cases",
  },
];
---

<Base title={title} description={description} path="/research">
  <header class="page-head">
    <h1>Research</h1>
    <p class="who">
      Biomedical engineering at UT Austin, Cockrell School, class of 2030.
    </p>
    <p class="lede">
      So far the work has been mostly stroke, and mostly the same question. How do you tell whether
      someone is actually getting better?
    </p>

    <nav class="head-index" aria-label="What is on this page">
      <ol>
        {
          index.map((i) => (
            <li>
              <span class="when">{i.when}</span>
              <a href={i.href}>{i.what}</a>
              <span class="gloss">{i.gloss}</span>
            </li>
          ))
        }
      </ol>
    </nav>

    <p class="head-reach">
      Reach me at <a href="mailto:aa228227&#64;my.utexas.edu">aa228227&#64;my.utexas.edu</a>.
    </p>
  </header>

  <section class="section" aria-labelledby="flagship">
    <h2 class="section-head" id="flagship">Most recent</h2>

    <div class="entry" id="device">
      <div class="entry-rail">
        <span>Jun to Jul 2025</span>
        <span class="sep">·</span>
        <span>UT Austin</span>
        <span class="sep">·</span>
        <span class="entry-note">completed</span>
      </div>

      <div>
        <h3>A stroke-aide device for pianists</h3>
        <p class="quiet">Freshman Research Initiative, High School Research Academy</p>
        <p>
          Playing the piano asks a hand to do something precise and repeatable, which makes it a
          useful place to watch fine motor control. I built a device that reads what a pianist's
          hands are doing, with a force sensor under each key and a microcontroller sampling them
          while you play. It came in at 99.7% accuracy in lab testing.
        </p>
        <p>
          I designed and ran the human subject side as well, more than 30 participants, to check
          that the device measured what it claimed to. Patrick Benfield and Rhiannon Morris mentored
          the research design and the analysis. The project took top presentation recognition at the
          end of the program.
        </p>

        <MotorTrace />

        <figure class="figure">
          <div class="figure-pending">
            Photograph of the device pending. Drop it in <code>public/img/</code> and swap this block.
          </div>
        </figure>

        <p>
          <a href="https://github.com/aadityathegreat/stroke-fine-motor-rehab"
            >Firmware and analysis code on GitHub</a
          >
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="before">
    <h2 class="section-head" id="before">Before that</h2>

    {
      experience.map((e) => (
        <article class="entry" id={e.id}>
          <div class="entry-rail">
            <span>{e.when}</span>
            <span class="sep">·</span>
            <span class="entry-note">{e.status}</span>
          </div>
          <div>
            <h3>{e.org}</h3>
            <p class="quiet">{e.place}</p>
            {e.body.map((para) => (
              <p>{para}</p>
            ))}
          </div>
        </article>
      ))
    }
  </section>

  <Contact lead="If any of this overlaps with what your lab works on, I'd like to hear about it." />
</Base>

<style>
  .page-head {
    margin-bottom: var(--space-2xl);
  }

  .page-head h1 {
    margin-bottom: var(--space-2xs);
  }

  /* The affiliation reads as the note's metadata rather than as prose, which
     keeps the question below it as the actual opening line. */
  .who {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-bottom: var(--space-md);
  }

  /* --- the index -----------------------------------------------------------
     The annotated-index half of the layout concept, used where it earns its
     keep. Rules and dates carry the structure; there is no box around anything.
     Numbers come from <ol> because the order is chronological and real, which
     is the opposite of the decorative "01 / 02 / 03" tell the Chanel pass cut.
     -------------------------------------------------------------------------- */

  .head-index {
    margin-top: var(--space-xl);
    border-top: 1px solid var(--rule-faint);
  }

  .head-index ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .head-index li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--rule-faint);
  }

  .head-index .when {
    display: block;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .head-index a {
    display: inline-block;
    /* Comfortable to tap without turning the list into a stack of buttons. */
    padding: var(--space-2xs) 0;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
    transition: border-color 220ms ease;
  }

  .head-index a:hover,
  .head-index a:focus-visible {
    border-color: var(--accent);
  }

  .head-index .gloss {
    display: block;
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: var(--measure);
  }

  .head-reach {
    margin-top: var(--space-lg);
    margin-bottom: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  @media (min-width: 52rem) {
    /* Same rail geometry as the entries below, so the index reads as the table
       of contents for the page rather than as a different component. */
    .head-index li {
      display: grid;
      grid-template-columns: 9.5rem 1fr;
      column-gap: var(--space-lg);
      row-gap: var(--space-2xs);
      align-items: baseline;
    }

    .head-index .when {
      text-align: right;
    }

    .head-index a {
      grid-column: 2;
      /* Without this the anchor stretches to the whole column and its underline
         reads as a section rule instead of as a link. */
      justify-self: start;
    }

    .head-index .gloss {
      grid-column: 2;
    }
  }

  code {
    font-family: ui-monospace, monospace;
    font-size: 0.875em;
  }
</style>
