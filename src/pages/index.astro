---
import Base from "../layouts/Base.astro";
import TraceRule from "../components/TraceRule.astro";

const title = "Aaditya Ananth";
const description =
  "Incoming biomedical engineering freshman at UT Austin. I build things that measure whether people are getting better.";

const doors = [
  {
    href: "/about",
    label: "About",
    what: "Prosper, debate, the gym, and the rest of what I do when I'm not in a lab.",
  },
  {
    href: "/research",
    label: "Research",
    what: "A stroke-aide device for pianists, neurology access in Texas, and a Neuro ICU.",
  },
  {
    href: "/building",
    label: "Building",
    what: "Small software I made because I wanted it to exist.",
  },
  {
    href: "/goals",
    label: "Goals",
    what: "Where I'm trying to get, and how far off most of it still is.",
  },
];
---

<Base title={title} description={description} path="/">
  <!-- One choreographed entrance, once, on the shortest page. This is a single
       opening moment rather than a per-section reveal, which is the line between
       deliberate motion and the fade-in-on-scroll tell. Nothing below animates on
       scroll anywhere on this page. -->
  <div class="intro">
    <h1 class="identity">Aaditya Ananth</h1>

    <div class="reveal" style="--d: 260ms">
      <TraceRule />
    </div>

    <p class="lede reveal" style="--d: 420ms">
      I start biomedical engineering at UT Austin, Cockrell School, in Fall 2026, with the class of
      2030.
    </p>

    <p class="lede-2 reveal" style="--d: 560ms">
      I'm interested in stroke recovery, and specifically in how you measure whether someone is
      actually getting better instead of just saying they feel better. Last summer that turned into
      a device I built for pianists, with a force sensor under every key.
    </p>
  </div>

  <nav class="doors reveal" style="--d: 720ms" aria-label="Sections of this site">
    <ul>
      {
        doors.map((d) => (
          <li>
            <a href={d.href}>
              <span class="door-label">
                {d.label}
                <span class="arrow" aria-hidden="true">
                  &#8594;
                </span>
              </span>
              <span class="what">{d.what}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="reach reveal" style="--d: 860ms">
    Reach me at <a href="mailto:aa228227&#64;eid.utexas.edu">aa228227&#64;eid.utexas.edu</a>.
  </p>
</Base>

<style>
  /* --- the entrance --------------------------------------------------------
     Each piece clips up from nothing on a staggered delay. motion.md permits
     stagger at an entrance moment; what it bans is stagger on every list forever.
     This fires once, on one page, and nothing repeats it on scroll.
     -------------------------------------------------------------------------- */

  .reveal {
    animation: rise 620ms var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }

  @keyframes rise {
    from {
      clip-path: inset(0 0 100% 0);
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
      transform: none;
    }
  }

  /* The name gets its own treatment. Literata is variable, so the weight axis
     eases into place under the reveal instead of the name simply appearing. */
  .identity {
    animation:
      identity-in 760ms var(--ease-out) both,
      identity-weight 1200ms var(--ease-out) both;
  }

  @keyframes identity-in {
    from {
      clip-path: inset(100% 0 0 0);
      opacity: 0;
    }
    to {
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @keyframes identity-weight {
    from {
      font-variation-settings: "wght" 420;
    }
    to {
      font-variation-settings: "wght" 600;
    }
  }

  /* Reduced motion keeps the sequence but strips the travel, so the page still
     assembles rather than jump-cutting into place. */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: fade 200ms linear both;
      animation-delay: 0ms;
    }

    @keyframes fade {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    .identity {
      animation: none;
      clip-path: none;
      opacity: 1;
      font-variation-settings: "wght" 600;
    }
  }

  /* --- layout -------------------------------------------------------------- */

  .intro {
    margin-bottom: var(--space-3xl);
  }

  .intro h1 {
    margin-bottom: var(--space-md);
  }

  .lede-2 {
    font-size: 1.0625rem;
    color: var(--ink-dim);
    max-width: var(--measure);
  }

  /* --- doors --------------------------------------------------------------- */

  .doors ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .doors li {
    border-top: 1px solid var(--rule-faint);
  }

  .doors li:last-child {
    border-bottom: 1px solid var(--rule-faint);
  }

  /* The whole row is the target, not just the word. */
  .doors a {
    display: block;
    padding: var(--space-md) 0;
    text-decoration: none;
  }

  .door-label {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--ink);
    display: block;
    margin-bottom: var(--space-2xs);
  }

  .arrow {
    display: inline-block;
    margin-left: 0.4em;
    color: var(--accent);
    transition: transform 240ms var(--ease-out);
  }

  .doors a:hover .arrow,
  .doors a:focus-visible .arrow {
    transform: translateX(5px);
  }

  .doors .what {
    color: var(--muted);
    display: block;
    max-width: var(--measure);
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow {
      transition: none;
    }
  }

  /* --- reach --------------------------------------------------------------- */

  .reach {
    margin-top: var(--space-2xl);
    color: var(--muted);
  }
</style>
