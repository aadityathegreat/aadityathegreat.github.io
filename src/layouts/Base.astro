---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = "/" } = Astro.props;
const site = "https://aadityathegreat.github.io";
const canonical = site + path;

// /writing exists but is deliberately absent here until there is a real post on
// it. An empty page linked from every other page advertises a habit that is not
// there yet, which costs more than not having the page at all.
const nav = [
  { href: "/about", label: "About" },
  { href: "/research", label: "Research" },
  { href: "/building", label: "Building" },
  { href: "/goals", label: "Goals" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/atkinson-next-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/literata-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta property="og:image:alt" content="Aaditya Ananth, research and selected work" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <div class="shell">
      <!-- Quiet nav. Two links and a name. The reader arrived from a targeted
           email, not a search result, so they do not need a site map first. -->
      <nav class="topbar" aria-label="Sections">
        {
          path === "/" ? (
            <span class="topbar-name">Aaditya Ananth</span>
          ) : (
            <a class="topbar-name" href="/">
              Aaditya Ananth
            </a>
          )
        }
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path === n.href ? "page" : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <main>
        <slot />
      </main>

      <!-- Contact lives in its own block on the pages that warrant it, so this
           stays a colophon rather than repeating the address twice per page. -->
      <footer class="colophon">
        <p class="set-in">
          Set in Literata and Atkinson Hyperlegible Next. Built with Astro, no trackers.
        </p>
      </footer>
    </div>
  </body>
</html>
